# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/hrms
APP_NAME="Philippine HRMS"
APP_TIMEZONE=Asia/Manila
APP_KEY=change-me-to-a-random-32-char-string

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hrms
DB_USER=root
DB_PASS=

# Session
SESSION_NAME=HRMS_SESS
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# Uploads
UPLOAD_MAX_SIZE=5242880